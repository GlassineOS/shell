#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-shutdown-screen [TARGET] — the shutdown screen (spec 009): the GlassineOS mark
# and one line over the whole screen, from the moment a restart or a power-off starts.
#
# TARGET: restart, poweroff, recovery, menu, other (the machine's other system),
# bootloader. Without one: the shutdown record's next= (GlassineOS/boot, written by
# reboot, poweroff, glassine-reboot-clean and glassine-deploy restart before they start
# the shutdown), else a soft restart's record (restart), else the power menu's power-off
# mark (poweroff), else unknown.
#
# Once per kernel run: the first call marks the shutdown as started
# (/run/glassine-shutdown-screen.lock: power daemons suspend no more, FR-013) and asks
# the session's glassine-shell to show the overlay ("shutdown-screen LINE" on its
# request socket). The shell shows it, holds the screen where the display keeps its
# picture, and answers "held" or "shown" in its runtime directory. Only on "held" this
# leaves /run/glassine-shutdown-screen (the target: a device's own power-off screen
# skips itself) and, for the targets that end in GlassineOS's loader (restart, menu,
# recovery), /run/glassine/screen-keep: the cold shutdown writes the splash store's
# "leave the screen" override from it (GlassineOS/boot 011), so the next start doesn't
# draw over the picture. Every later call does nothing.
#
# Called by glassine-power-root before anything slow, and by the session's service as
# its stop begins while the system goes down. Never fails a shutdown: exit 0, at most
# about five seconds.
RUN=${GLASSINE_RUN:-/run}
USERS=${GLASSINE_USER_RUN:-/run/user}
SHELLBIN=${GLASSINE_SHELL:-/usr/bin/glassine-shell}
DONE=$RUN/glassine-shutdown-screen
ANSWER_TENTHS=30        # the shell's answer: at most 3 s

t=${1:-}
if [ -z "$t" ]; then
	t=$(sed -n 's/^next=\([a-z0-9-]*\)$/\1/p' "$RUN/glassine/shutdown" 2>/dev/null | tail -n 1)
	[ -n "$t" ] || { [ -e "$RUN/glassine/restarting" ] && t=restart; }
	[ -n "$t" ] || { [ -e "$RUN/glassine-poweroff" ] && t=poweroff; }
fi

# the words, one table (spec 009 FR-003)
case $t in
	restart|menu|bootloader) line='Restarting…' ;;
	recovery) line='Starting recovery…' ;;
	other) line='Starting Android…' ;;
	poweroff) line='Powered off' ;;
	*) t=unknown line='Shutting down…' ;;
esac

# once: the first caller wins; the lock also says "a shutdown has started" (FR-013)
mkdir "$DONE.lock" 2>/dev/null || exit 0

# the session's shell: the first runtime directory with its socket
d=
for s in "$USERS"/*/glassine-shell; do
	[ -S "$s" ] && { d=${s%/*}; break; }
done
[ -n "$d" ] || exit 0
A=$d/glassine-shutdown-screen.shown
rm -f "$A"
XDG_RUNTIME_DIR=$d timeout 1 "$SHELLBIN" shutdown-screen "$line" >/dev/null 2>&1 || exit 0
i=0
while [ ! -s "$A" ] && [ $i -lt $ANSWER_TENTHS ]; do sleep 0.1; i=$((i + 1)); done
[ "$(cat "$A" 2>/dev/null)" = held ] || exit 0
echo "$t" > "$DONE"
case $t in
	restart|menu|recovery)
		mkdir -p "$RUN/glassine" 2>/dev/null && : > "$RUN/glassine/screen-keep" ;;
esac
exit 0
