#!/bin/sh
# glassine-zram: compressed swap in RAM (zram) that spills parked apps to the user
# data partition, compressed hard on disk. Started by the service glassine-zram.
#
# Parked apps (glassine-bgprio freezes hidden ones) get pushed out of RAM: bgprio
# pages the frozen processes out (process_madvise MADV_PAGEOUT), which lands here
# compressed with a fast algorithm (fast to decompress = fast to switch back).
# `glassine-zram park` then moves exactly one app's slots on to disk
# (glassine-zpark: its zram slots from /proc/PID/pagemap, recompressed, then
# `writeback page_indexes=`), so only parked apps cost disk writes; the app in
# front never does.
#
# The disk side: zram writes whole pages per slot, even with compressed_writeback,
# and a swap file can't live on a compressing file system. So zram's backing
# device is a loop over a file on a btrfs mounted compress-force=zstd: btrfs packs
# the pages of one park (consecutive blocks) into compressed extents. That btrfs
# is an image file in the spill directory on userdata:
#   SPILL_DIR/spill.btrfs  (preallocated, SPILL_MB)  -> loop -> btrfs at /run/glassine-zram
#   /run/glassine-zram/wb  (sparse, WB_SIZE_MB, new at every start) -> loop -> zram0 backing_dev
# Without mkfs.btrfs (btrfs-progs) it falls back to a plain preallocated file,
# SPILL_DIR/writeback (WB_SIZE_MB). The spill only comes up when userdata is
# mounted and leaves USERDATA_RESERVE_MB free; otherwise zram runs in RAM only.
# Nothing in the spill outlives a boot: a broken image is recreated.
#
#   glassine-zram start                  set up zram0 (+ the spill), swapon
#   glassine-zram stop                   swapoff (pages come back into RAM), tear down
#   glassine-zram park (-c CG | PID...)  one parked app's zram slots -> disk (glassine-zpark)
#   glassine-zram writeback [S]          every slot idle for >= S seconds (1800) -> disk
#   glassine-zram status                 sizes, compression ratios, counters
#
# Settings: /etc/glassine/zram (shell KEY=value, all optional; a device package
# or image stage ships its own values):
#   ZRAM_SIZE            uncompressed swap size, RAM + disk (K/M/G suffix; default: the RAM size)
#   ZRAM_MEM_LIMIT       compressed RAM zram may use (default: a quarter of the RAM)
#   ZRAM_ALGO            first algorithm (lz4)
#   RECOMP_ALGO          second algorithm, for glassine-zpark's per-app recompression (zstd)
#   RECOMP_LEVEL         its level (3); 0 = no recompression
#   WB_SIZE_MB           logical size of the spill (4096); 0 = no spill
#   SPILL_MB             disk space for the btrfs image (2048)
#   SPILL_LEVEL          btrfs zstd level 1-15 (9)
#   SPILL_DIR            where the spill files live (default: USERDATA_PREFIX/zram on
#                        userdata, from /etc/glassine/deploy.conf)
#   USERDATA_RESERVE_MB  free space the spill never takes on userdata (4096)
#   SWAPPINESS           vm.swappiness while zram is on (20: eager swapping
#                        fragments memory, and large allocations then get slower)
# /etc/glassine/deploy.conf (GlassineOS/boot; GLASSINE_DEPLOY_CONF names another):
# USERDATA_MNT (/run/glassine/userdata), USERDATA_PREFIX (media/glassine).
# GLASSINE_ZRAM_ROOT: a directory standing in for / (tests only).
set -u
ROOT=${GLASSINE_ZRAM_ROOT:-}
ZRAM_SIZE=
ZRAM_MEM_LIMIT=
ZRAM_ALGO=lz4
RECOMP_ALGO=zstd
RECOMP_LEVEL=3
WB_SIZE_MB=4096
SPILL_MB=2048
SPILL_LEVEL=9
SPILL_DIR=
USERDATA_RESERVE_MB=4096
SWAPPINESS=20
CONF=$ROOT/etc/glassine/zram
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

# deploy.conf: only the two keys, without running the file
DEPLOY_CONF=${GLASSINE_DEPLOY_CONF:-$ROOT/etc/glassine/deploy.conf}
conf_key() { [ -r "$DEPLOY_CONF" ] && sed -n "s/^$1=//p" "$DEPLOY_CONF" | tail -n 1; }
UD_MNT=$(conf_key USERDATA_MNT); UD_MNT=${UD_MNT:-/run/glassine/userdata}
UD_PREFIX=$(conf_key USERDATA_PREFIX); UD_PREFIX=${UD_PREFIX:-media/glassine}

Z=$ROOT/sys/block/zram0
SPILL=$ROOT/run/glassine-zram
if [ -n "$SPILL_DIR" ]; then
	DIR=$ROOT$SPILL_DIR; NEED=$(dirname "$DIR")   # the directory above must exist
else
	DIR=$ROOT$UD_MNT/$UD_PREFIX/zram; NEED=$ROOT$UD_MNT   # userdata must be mounted
fi
IMG=$DIR/spill.btrfs
PLAIN=$DIR/writeback                    # the fallback without btrfs-progs
log() { echo "glassine-zram: $*" >&2; }  # stderr: backing_dev's stdout is the loop device

mem_kb() { awk '$1 == "MemTotal:" { print $2 }' "$ROOT/proc/meminfo"; }

have_zram() {
	[ -e "$Z" ] || modprobe zram num_devices=1 2>/dev/null
	[ -e "$Z" ]
}

# losetup FILE [dio] -> the loop device on stdout. Only util-linux losetup has
# --direct-io/--show; busybox has neither: next free device, then bind
loop_of() {
	local dev
	if losetup --help 2>&1 | grep -q -- --direct-io; then
		if [ "${2:-}" = dio ]; then dev=$(losetup --direct-io=on -f --show "$1")
		else dev=$(losetup -f --show "$1"); fi || return 1
	else
		dev=$(losetup -f) && losetup "$dev" "$1" || return 1
	fi
	echo "$dev"
}

free_mb() { df -Pk "$1" | awk 'NR == 2 { print int($4 / 1024) }'; }

# room for a file growing from $1 to $2 MiB, keeping USERDATA_RESERVE_MB free
room_for() {
	local f
	f=$(free_mb "$DIR") || return 1
	[ $(( f + $1 - $2 )) -ge "$USERDATA_RESERVE_MB" ] || { log "only $f MiB free in $DIR (reserve $USERDATA_RESERVE_MB MiB)"; return 1; }
}

size_mb() { if [ -f "$1" ]; then echo $(( $(stat -c %s "$1") / 1048576 )); else echo 0; fi; }

# a preallocated file of $2 MiB at $1 (allocated for real: writeback must not
# find userdata full)
prealloc() {
	[ "$(size_mb "$1")" -eq "$2" ] && return 0
	room_for "$(size_mb "$1")" "$2" || return 1
	rm -f "$1"
	fallocate -l "${2}M" "$1" 2>/dev/null ||
		dd if=/dev/zero of="$1" bs=1M count="$2" 2>/dev/null || { rm -f "$1"; return 1; }
	chmod 600 "$1"
}

spill_mount() { mount -t btrfs -o "compress-force=zstd:$SPILL_LEVEL,noatime" "$1" "$SPILL"; }

# the btrfs spill: image -> loop -> btrfs at $SPILL -> new sparse file -> loop
spill_btrfs() {
	command -v mkfs.btrfs >/dev/null || { log "no mkfs.btrfs (btrfs-progs): plain spill file"; return 1; }
	rm -f "$PLAIN"                      # the plain file's space goes to the image
	local fresh=0 img
	[ "$(size_mb "$IMG")" -eq "$SPILL_MB" ] || { prealloc "$IMG" "$SPILL_MB" || return 1; fresh=1; }
	img=$(loop_of "$IMG" dio) || { log "losetup $IMG failed"; return 1; }
	mkdir -p "$SPILL"
	if [ $fresh = 1 ] || ! spill_mount "$img" 2>/dev/null; then
		if ! { mkfs.btrfs -q -f -m single -d single -L glassine-zram "$img" >/dev/null && spill_mount "$img"; }; then
			log "btrfs on $IMG failed"; losetup -d "$img"; return 1
		fi
	fi
	# zram's backing data never outlives a boot: a new file each start, which
	# also frees what the last boot left (copy-on-write extents)
	rm -f "$SPILL/wb" && truncate -s "${WB_SIZE_MB}M" "$SPILL/wb" && chmod 600 "$SPILL/wb" || return 1
	loop_of "$SPILL/wb" || { log "losetup $SPILL/wb failed"; return 1; }
}

spill_plain() {
	prealloc "$PLAIN" "$WB_SIZE_MB" || return 1
	loop_of "$PLAIN" dio
}

# the loop device zram writes back to, or nothing (no userdata, no room)
backing_dev() {
	[ "$WB_SIZE_MB" -gt 0 ] || { log "WB_SIZE_MB 0: no spill"; return 1; }
	[ -e "$Z/backing_dev" ] || { log "no zram writeback in this kernel: no spill"; return 1; }
	if [ -z "$SPILL_DIR" ]; then
		mountpoint -q "$NEED" || { log "userdata not mounted at $UD_MNT: no spill"; return 1; }
	else
		[ -d "$NEED" ] || { log "no $NEED: no spill"; return 1; }
	fi
	mkdir -p "$DIR" && chmod 700 "$DIR" || return 1
	spill_btrfs || spill_plain
}

# the files whose page cache holds written-back pages (glassine-zpark drops it)
spill_files() {
	if mountpoint -q "$SPILL"; then echo "-f $SPILL/wb -f $IMG"
	elif [ -f "$PLAIN" ]; then echo "-f $PLAIN"; fi
}

on() { grep -q '^/dev/zram0 ' "$ROOT/proc/swaps"; }
spilling() { case "$(cat "$Z/backing_dev" 2>/dev/null)" in /dev/*) return 0 ;; esac; log "no spill"; return 1; }

# zram reset, the spill's loops detached and the btrfs unmounted (stop, a failed start)
teardown() {
	local loop img
	loop=$(cat "$Z/backing_dev" 2>/dev/null)
	echo 1 > "$Z/reset" 2>/dev/null
	case "$loop" in /dev/loop*) losetup -d "$loop" 2>/dev/null ;; esac
	if mountpoint -q "$SPILL"; then
		img=$(awk -v m="${SPILL#"$ROOT"}" '$2 == m { print $1 }' "$ROOT/proc/mounts")
		umount "$SPILL" && case "$img" in /dev/loop*) losetup -d "$img" 2>/dev/null ;; esac
	fi
}
failed() { log "start failed: $*"; teardown; exit 1; }

case "${1:-}" in
start)
	have_zram || { log "no zram in this kernel"; exit 1; }
	if on; then log "already on"; exit 0; fi
	if [ -z "$ZRAM_SIZE" ] || [ -z "$ZRAM_MEM_LIMIT" ]; then
		kb=$(mem_kb)
		[ -n "$kb" ] || { log "no MemTotal in /proc/meminfo: set ZRAM_SIZE and ZRAM_MEM_LIMIT"; exit 1; }
		ZRAM_SIZE=${ZRAM_SIZE:-${kb}K}
		ZRAM_MEM_LIMIT=${ZRAM_MEM_LIMIT:-$(( kb / 4 ))K}
	fi
	echo 1 > "$Z/reset" 2>/dev/null
	echo "$ZRAM_ALGO" > "$Z/comp_algorithm" || log "no $ZRAM_ALGO, kernel default"
	# the second algorithm, for glassine-zpark's per-app recompression
	if [ "$RECOMP_LEVEL" -gt 0 ] && [ -e "$Z/recomp_algorithm" ]; then
		if ! { echo "algo=$RECOMP_ALGO priority=1" > "$Z/recomp_algorithm" &&
			echo "priority=1 level=$RECOMP_LEVEL" > "$Z/algorithm_params"; }; then
			log "no $RECOMP_ALGO recompression"
		fi
	fi
	# raw pages to the spill: btrfs compresses them far better than the first algorithm's output
	[ -e "$Z/compressed_writeback" ] && echo no > "$Z/compressed_writeback"
	if loop=$(backing_dev); then
		if echo "$loop" > "$Z/backing_dev"; then
			if mountpoint -q "$SPILL"; then how="btrfs zstd:$SPILL_LEVEL in $IMG"; else how=$PLAIN; fi
			log "spill to $loop ($how)"
		else
			losetup -d "$loop"
		fi
	fi
	echo "$ZRAM_SIZE" > "$Z/disksize" || failed "disksize $ZRAM_SIZE"
	echo "$ZRAM_MEM_LIMIT" > "$Z/mem_limit"
	[ -e "$Z/writeback_limit_enable" ] && echo 0 > "$Z/writeback_limit_enable"
	mkswap /dev/zram0 >/dev/null || failed mkswap
	swapon -p 100 /dev/zram0 || failed swapon
	echo "$SWAPPINESS" > "$ROOT/proc/sys/vm/swappiness"
	# zram pages are decompressed one at a time: no read-ahead clusters
	echo 0 > "$ROOT/proc/sys/vm/page-cluster"
	log "on: $ZRAM_SIZE ($ZRAM_ALGO, RAM limit $ZRAM_MEM_LIMIT), swappiness $SWAPPINESS"
	;;
stop)
	on && swapoff /dev/zram0
	teardown
	exit 0
	;;
park)
	shift
	spilling || exit 0
	# shellcheck disable=SC2046
	exec /usr/sbin/glassine-zpark $(spill_files) "$@"
	;;
writeback)
	age=${2:-1800}
	spilling || exit 0
	rc=0
	{ echo "$age" > "$Z/idle" && echo idle > "$Z/writeback"; } || rc=1
	# bd_stat: bd_count bd_reads bd_writes (4 KiB pages)
	log "writeback (idle >= ${age}s): rc $rc, on disk now $(awk '{ print $1 * 4 " KiB, written " $3 * 4 " KiB" }' "$Z/bd_stat")"
	exit $rc
	;;
status)
	grep zram0 "$ROOT/proc/swaps" || { echo "zram0 off"; exit 0; }
	# mm_stat: orig_data compr_data mem_used mem_limit mem_used_max same_pages pages_compacted huge_pages
	awk '{ printf "RAM: stored %d MiB in %d MiB (ratio %.1f), peak %d MiB\n", $1/1048576, $3/1048576, ($3 ? $1/$3 : 0), $5/1048576 }' "$Z/mm_stat"
	echo "spill $(cat "$Z/backing_dev")"
	[ -e "$Z/bd_stat" ] && awk '{ printf "disk: %d MiB of pages, read back %d MiB, written %d MiB in total\n", $1/256, $2/256, $3/256 }' "$Z/bd_stat"
	if mountpoint -q "$SPILL"; then
		sync -f "$SPILL/wb" 2>/dev/null
		echo "btrfs zstd:$SPILL_LEVEL: $(( $(df -Pk "$SPILL" | awk 'NR == 2 { print $3 }') / 1024 )) MiB used of $SPILL_MB (includes metadata)"
	fi
	echo "swappiness $(cat "$ROOT/proc/sys/vm/swappiness")"
	;;
*)
	echo "usage: glassine-zram start|stop|park (-c CGROUP | PID...)|writeback [SECONDS]|status" >&2; exit 2
	;;
esac
