#!/bin/sh
# Root half of glassine-power (allowed for the desktop user via /etc/doas.d/glassine.conf).
# A power-off or restart from the menu is user-started: it may switch a staged
# deployment (GlassineOS/boot glassine-switch-hook; absent on the plain layout).
# Anyone: sleep, hibernate, poweroff, reboot, reboot-full, restart-check, android, recovery, menu (no prompt: like the
# recovery, the loader's start menu offers only this machine's own systems and recovery).
# The shutdown screen (spec 009) first, before anything that takes time; only where the
# shutdown can't be refused any more (recovery and menu get it from the session's stop).
SCREEN=${GLASSINE_SHUTDOWN_SCREEN:-/usr/sbin/glassine-shutdown-screen}
screen() { [ ! -x "$SCREEN" ] || "$SCREEN" "$1"; }
user_shutdown() { command -v glassine-switch-hook >/dev/null && glassine-switch-hook --user-shutdown; return 0; }
# GlassineOS/boot's restart step (glassine-deploy restart, spec 013): soft where the
# deployments allow (the apps close, the kernel keeps running), else cold; it runs the
# user-shutdown hook itself. Older tools and the plain layout: an ordinary reboot.
has_restart() {
	[ -x /usr/sbin/glassine-deploy ] || return 1
	/usr/sbin/glassine-deploy restart --check >/dev/null 2>&1
	case $? in 0|9) return 0 ;; *) return 1 ;; esac
}
case "$1" in
	poweroff) : > /run/glassine-poweroff; screen poweroff; user_shutdown; exec poweroff ;;
	reboot)   # "Restart": soft where it can be; a restart the step refuses (busy, no space for the
	          # switch) is an ordinary one, as the person asked to restart
		screen restart
		# no --check first: restart decides soft or cold itself, and one that refuses
		# (busy, no space, no deployments) returns without restarting
		if [ -x /usr/sbin/glassine-deploy ]; then
			/usr/sbin/glassine-deploy restart
			# it returned while its restart runs (the stop ended it): nothing more to do
			[ ! -e /run/glassine/restarting ] || exit 0
		fi
		user_shutdown; exec reboot ;;
	reboot-full) # "Restart fully": always cold, through the firmware
		screen restart
		if [ -x /usr/sbin/glassine-deploy ]; then /usr/sbin/glassine-deploy restart --cold; fi
		user_shutdown; exec reboot ;;
	restart-check) # what "Restart" would be: the step's porcelain record (nothing where it has none)
		has_restart || exit 0
		/usr/sbin/glassine-deploy restart --check --porcelain; exit 0 ;;
	sleep)    exec kill -USR1 $(pidof glassine-powerd) ;;               # glassine-powerd sleeps as on the power key
	hibernate) # glassine-powerd: the pill, the light and radios off, then glassine-hibernate now
		/usr/sbin/glassine-hibernate check >/dev/null || exit 3
		exec kill -USR2 $(pidof glassine-powerd) ;;
	android)  # the device's second system: its package names the slot in slots.conf (ANDROID_SLOT=a|b);
	          # made active and marked successful, so the boot loader keeps it (GlassineOS/boot glassine-slot)
		s=$(sed -n 's/^ANDROID_SLOT=\([ab]\)$/\1/p' "${GLASSINE_SLOTS_CONF:-/etc/glassine/slots.conf}" 2>/dev/null | tail -n 1)
		[ -n "$s" ] || { echo "$0: no second system on this device" >&2; exit 3; }
		/usr/sbin/glassine-slot set-active "$s" --successful || exit
		screen other
		exec reboot ;;
	recovery) exec /usr/sbin/glassine-reboot-clean recovery ;;   # p9 (TWRP or a mainline test image); its "Reboot" comes back here
	menu)     # the loader's start menu at the next start (GlassineOS/boot: request=menu in the
	          # loader record, then a plain reboot; as recovery, no staged switch); exit 3 where the
	          # loader takes no such request, nothing written
		exec /usr/sbin/glassine-reboot-clean menu ;;
	*) echo "usage: $0 sleep|hibernate|poweroff|reboot|reboot-full|restart-check|android|recovery|menu" >&2; exit 2 ;;
esac
