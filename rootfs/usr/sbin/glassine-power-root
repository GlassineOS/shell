#!/bin/sh
# Root half of glassine-power (allowed for the desktop user via /etc/doas.d/glassine.conf).
# A power-off or restart from the menu is user-started: it may switch a staged
# deployment (GlassineOS/boot glassine-switch-hook; absent on the plain layout).
# Anyone: sleep, poweroff, reboot, android, recovery (no prompt).
user_shutdown() { command -v glassine-switch-hook >/dev/null && glassine-switch-hook --user-shutdown; return 0; }
case "$1" in
	poweroff) : > /run/glassine-poweroff; user_shutdown; exec poweroff ;;   # glassine-splash shows the power-off screen
	reboot)   user_shutdown; exec reboot ;;
	sleep)    exec kill -USR1 $(pidof glassine-powerd) ;;               # glassine-powerd sleeps as on the power key
	android)  # the device's second system: its package names the slot in slots.conf (ANDROID_SLOT=a|b);
	          # made active and marked successful, so the boot loader keeps it (GlassineOS/boot glassine-slot)
		s=$(sed -n 's/^ANDROID_SLOT=\([ab]\)$/\1/p' "${GLASSINE_SLOTS_CONF:-/etc/glassine/slots.conf}" 2>/dev/null | tail -n 1)
		[ -n "$s" ] || { echo "$0: no second system on this device" >&2; exit 3; }
		/usr/sbin/glassine-slot set-active "$s" --successful || exit
		exec reboot ;;
	recovery) exec /usr/sbin/glassine-reboot-clean recovery ;;   # p9 (TWRP or a mainline test image); its "Reboot" comes back here
	*) echo "usage: $0 sleep|poweroff|reboot|android|recovery" >&2; exit 2 ;;
esac
