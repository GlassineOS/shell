# The person's settings that a switch (an update, a reset) carries into the next
# deployment: what glassine-settings, the quick settings and the first-run setup write.
# Image configuration (epd.conf, rotd.conf, slots.conf, deploy.conf) is not listed: an
# update brings its own. A setting turned off by removing its file is not carried.
/etc/glassine/eink.conf
/etc/glassine/power.conf
/etc/glassine/rotation
/etc/glassine/bgprio.conf
/etc/glassine/zram
/etc/glassine/ddr
/etc/glassine/ntp-off
/etc/glassine/osk-layers
/etc/glassine/home-app
/etc/glassine/grid-hidden
/etc/glassine/launch-boost
/etc/glassine/epd-gpu
/etc/glassine/sway-gpu
/etc/glassine/sway-grey
/etc/glassine/sway-latch
/etc/glassine/sway-heap
/etc/glassine/gpu-prio
/etc/glassine/gpu-prio-ingest
/etc/glassine/fg-boost
/etc/glassine/gpu-app-l3
/etc/glassine/gpu-app-split
/etc/glassine/gpu-app-nol4
/etc/glassine/setup.conf
/etc/glassine/setup-done
# the fast defaults were set once (glassine-session-sway): carried, so an update does
# not set them again over the person's choices; every flag the defaults write is listed
# above, or the marker would keep them from coming back
/etc/glassine/defaults-14
/etc/glassine/defaults-15
/etc/glassine/defaults-16
/etc/glassine/defaults-17
/etc/glassine/defaults-18
/etc/glassine/defaults-19
/etc/glassine/defaults-20
# the per-app render seed was applied
/var/lib/glassine/render-seeded/
