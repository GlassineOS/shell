#!/bin/sh
# The home app (spec 001 FR-029), started by the sway config and started again
# whenever it exits while the session runs (a clean exit too: SIGTERM, or sway
# closing it); glassine-swayd keeps it in the scratchpad and shows it over the work area.
# A quick exit doubles the pause before the next start (1 s up to 60 s); a run of
# 60 s or more resets it. The session is over when sway no longer answers on
# $SWAYSOCK or the Wayland display's compositor is gone: then it stops. Neither
# known: started once.
# Its app_id as glassine-swayd and glassine-shell find it: $GLASSINE_HOME_APP_ID,
# else the first word of /etc/glassine/home-app, else glassine-home. Started from
# its desktop entry (ID.desktop in the XDG data dirs, field codes dropped), else a
# command of that name. Neither: exits quietly (no home app installed).
#   glassine-home-start [-n]    -n: print the command, start nothing
id=${GLASSINE_HOME_APP_ID:-}
if [ -z "$id" ] && [ -r /etc/glassine/home-app ]; then
    read -r id _ < /etc/glassine/home-app || :
    id=${id%"$(printf '\r')"}
fi
id=${id:-glassine-home}
case $id in */* | .*) echo "glassine-home-start: not an app_id: $id" >&2; exit 0 ;; esac
cmd=
set -f; IFS=:                   # the data dirs split at ":", no globbing
# shellcheck disable=SC2086
for d in "${XDG_DATA_HOME:-$HOME/.local/share}" ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
    f=$d/applications/$id.desktop
    [ -r "$f" ] || continue
    cmd=$(sed -n '/^\[Desktop Entry\]/,/^\[/{s/^Exec=//p;}' "$f" | head -1 | sed 's/ *%[fFuUdDnNickvm]//g')
    [ -n "$cmd" ] && break
done
unset IFS; set +f
if [ -z "$cmd" ]; then
    command -v "$id" >/dev/null 2>&1 || exit 0
    cmd=$id
fi
[ "${1:-}" = -n ] && { echo "$cmd"; exit 0; }
# the session: sway answers on its IPC socket ($SWAYSOCK), the Wayland display's lock
# is held (its compositor holds it: a crash leaves both socket files behind)
wl=
case ${WAYLAND_DISPLAY:-} in
    '') ;;
    /*) wl=$WAYLAND_DISPLAY ;;
    *) [ -n "${XDG_RUNTIME_DIR:-}" ] && wl=$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY ;;
esac
running() {
    [ -n "${SWAYSOCK:-}$wl" ] || return 1
    if [ -n "${SWAYSOCK:-}" ]; then
        [ -S "$SWAYSOCK" ] || return 1
        if command -v swaymsg >/dev/null 2>&1; then
            swaymsg -s "$SWAYSOCK" -t get_version >/dev/null 2>&1 || return 1
        fi
    fi
    if [ -n "$wl" ]; then
        [ -S "$wl" ] || return 1
        if [ -e "$wl.lock" ] && command -v flock >/dev/null 2>&1; then
            ! flock -n "$wl.lock" true 2>/dev/null || return 1
        fi
    fi
}
pause=1
while :; do
    t0=$(date +%s)
    sh -c "$cmd"
    running || exit 0
    if [ $(($(date +%s) - t0)) -ge 60 ]; then
        pause=1
    else
        sleep "$pause"
        pause=$((pause * 2 > 60 ? 60 : pause * 2))
        running || exit 0
    fi
done
