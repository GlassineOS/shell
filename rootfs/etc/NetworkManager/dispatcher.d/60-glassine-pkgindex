#!/bin/sh
# Refresh the apk index when a connection comes up, at most once a day. Without the
# index, apk search finds nothing.
#
# On a deployment / is read-only and apk takes its lock under /, so the update goes
# through the glassine wrapper (/usr/sbin/glassine), which opens / for that run only;
# NetworkManager's PATH has /sbin (apk-tools) before /usr/sbin (the wrapper's apk link),
# hence the explicit path. Without the wrapper: apk-tools.
# GLASSINE_PKGINDEX_WAIT (seconds, default 20) is for the tests.
[ "$2" = up ] || exit 0
DIR=/var/lib/glassine
STAMP=$DIR/pkgindex-stamp
[ -n "$(find $STAMP -mmin -1440 2>/dev/null)" ] && exit 0
mkdir -p $DIR
apk_update() {
    if [ -x /usr/sbin/glassine ]; then
        GLASSINE_APK_ACK=1 /usr/sbin/glassine apk update -q
    else
        apk update -q
    fi
}
(
    flock -n 9 || exit 0            # one refresh at a time (two "up" events)
    sleep "${GLASSINE_PKGINDEX_WAIT:-20}"   # let DNS / the clock settle first
    apk_update 9>&- || exit 0
    touch $STAMP
) 9>$DIR/pkgindex.lock >/dev/null 2>&1 &
exit 0
