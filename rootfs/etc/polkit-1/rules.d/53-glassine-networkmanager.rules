// NetworkManager for the desktop user (group wheel): glassine-settings adds, changes
// and forgets Wi-Fi profiles with nmcli (`nmcli con mod … wifi-sec.psk` when
// glassine-nm-agent's notice asks for a new password). Alpine's own rule (plugdev)
// wants an "active" session, which polkit can't see here (no logind/elogind),
// so without this every profile change would ask for admin auth.
// Every desktop user may use the networks already saved (connect, scan, Wi-Fi on/off).
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0 && subject.isInGroup("wheel"))
        return polkit.Result.YES;
    if ((action.id == "org.freedesktop.NetworkManager.network-control" ||
         action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
         action.id == "org.freedesktop.NetworkManager.enable-disable-wifi") && subject.isInGroup("desktop"))
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
